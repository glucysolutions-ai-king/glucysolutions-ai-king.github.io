---
import Layout from '../layouts/Layout.astro';
import FlipHero from '../components/FlipHero.astro';
import { stageCredits } from '../data/credits';
---
<Layout
  title="Gary Lucy — Stage Credits"
  description="Gary Lucy's theatre work, including headlining the award-winning, number one UK touring production of The Full Monty as Gaz."
  path="/stage"
>
  <article class="rs-page">
    <FlipHero
      id="stage"
      imageFront="/portraits/gl-studio2-web.jpg"
      imageBack="/gallery/gary-lucy-sitting-1600.jpg"
      altFront="Gary Lucy, studio portrait for his stage work"
      altBack="Gary Lucy, studio portrait"
      kicker="Theatre"
      headline="Stage Credits"
      dek="From soap sets to the UK tour boards &mdash; the first act of a second career."
      backKicker="Live"
      backHeadline="Eight Shows<br />A Week"
    />

    <div class="rs-body">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Stage</span>
      </nav>

      <p class="rs-lede">
        Alongside his screen work, Lucy took to the boards headlining the
        award-winning, number one UK touring production of <em>The Full Monty</em>
        as Gaz &mdash; a run that toured the country over several years.
      </p>
      <ul class="rs-rows">
        {stageCredits.map((c) => (
          <li>
            <div>
              <span class="rs-row-name">{c.role} &mdash; {c.title}</span>
              <p style="font-family:'Helvetica Neue',Arial,sans-serif; font-size:0.85rem; color:var(--rs-meta); margin:0.3em 0 0; max-width:60ch;">{c.venue} &middot; {c.summary}</p>
            </div>
            <span class="rs-row-meta">{c.years}</span>
          </li>
        ))}
      </ul>
    </div>
  </article>
</Layout>
