---
import Layout from '../../layouts/Layout.astro';
import { roles } from '../../data/credits';

export function getStaticPaths() {
  return roles.map((role) => ({
    params: { slug: role.slug },
    props: { role },
  }));
}

const { role } = Astro.props;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.garylucy.co.uk/' },
      { '@type': 'ListItem', position: 2, name: 'Screen', item: 'https://www.garylucy.co.uk/screen' },
      { '@type': 'ListItem', position: 3, name: role.show, item: `https://www.garylucy.co.uk/screen/${role.slug}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TVSeries',
    name: role.show,
    actor: { '@id': 'https://www.garylucy.co.uk/#person' },
  },
];
---
<Layout title={role.seoTitle} description={role.seoDescription} path={`/screen/${role.slug}`} jsonLd={jsonLd}>
  <section class="container" style="padding: 6rem 1.5rem 4rem; max-width: 760px;">
    <p class="eyebrow">{role.network} · {role.years} · {role.type}</p>
    <h1>{role.show}</h1>
    <p style="font-size:1.1rem;">Gary Lucy as <strong>{role.character}</strong></p>
    <p>{role.summary}</p>
    <a href="/screen" class="accent">&larr; All screen credits</a>
  </section>
</Layout>
