---
import Layout from '../../layouts/Layout.astro';
import { roles } from '../../data/credits';

export function getStaticPaths() {
  return roles.map((role) => ({
    params: { slug: role.slug },
    props: { role },
  }));
}

const { role } = Astro.props;

const heroFor: Record<string, string> = {
  hollyoaks: '/portraits/gl-standing2-web.jpg',
  'footballers-wives': '/gallery/gary-lucy-jacket-1600.jpg',
  'the-bill': '/gallery/gary-lucy-wing-1600.jpg',
  eastenders: '/portraits/gl-seated2-web.jpg',
  'the-good-ship-murder': '/portraits/gl-walking2-web.jpg',
};
const hero = heroFor[role.slug] ?? '/hero/gl-standing-bw-web.jpg';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.garylucy.co.uk/' },
      { '@type': 'ListItem', position: 2, name: 'Screen', item: 'https://www.garylucy.co.uk/screen' },
      { '@type': 'ListItem', position: 3, name: role.show, item: `https://www.garylucy.co.uk/screen/${role.slug}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TVSeries',
    name: role.show,
    actor: { '@id': 'https://www.garylucy.co.uk/#person' },
  },
];
---
<Layout title={role.seoTitle} description={role.seoDescription} path={`/screen/${role.slug}`} jsonLd={jsonLd}>
  <article class="rs-page">
    <header class="rs-hero rs-hero-sm">
      <img src={hero} alt={role.show} class="rs-hero-img" />
      <div class="rs-hero-scrim"></div>
      <div class="rs-hero-content">
        <p class="rs-kicker">{role.network} &middot; {role.years} &middot; {role.type}</p>
        <h1 class="rs-headline">{role.show}</h1>
        <p class="rs-dek">Gary Lucy as {role.character}</p>
      </div>
    </header>

    <div class="rs-body">
      <p class="rs-lede">{role.summary}</p>
      <a href="/screen" class="rs-eyebrow">&larr; All screen credits</a>
    </div>
  </article>
</Layout>
