---
import Layout from '../../layouts/Layout.astro';
import FlipHero from '../../components/FlipHero.astro';
import { roles } from '../../data/credits';
import { SITE_URL, absoluteUrl } from '../../data/site';

export function getStaticPaths() {
  return roles.map((role) => ({
    params: { slug: role.slug },
    props: { role },
  }));
}

const { role } = Astro.props;

const heroFor: Record<string, string> = {
  hollyoaks: '/gallery/gary-lucy-actor-standing-editorial.jpg',
  'footballers-wives': '/gallery/gary-lucy-jacket-1600.jpg',
  'the-bill': '/gallery/gary-lucy-wing-1600.jpg',
  eastenders: '/gallery/gary-lucy-actor-seated-editorial.jpg',
  'the-good-ship-murder': '/gallery/gary-lucy-actor-walking-editorial.jpg',
  'the-chelsea-detective': '/hero/gl-sitting-bw-web.jpg',
};
const hero = heroFor[role.slug] ?? '/hero/gary-lucy-actor-full-length-black-white.jpg';

// Per-role editorial copy. Grounded only in facts already verified in
// src/data/credits.ts (character, show, network, years, award record) —
// no plot, episode-count or production detail is stated here unless it's
// also present there. See FACT_CHECK_REQUIRED.md for anything held back
// pending Gary's confirmation.
const bodyFor: Record<string, string[]> = {
  hollyoaks: [
    'Gary Lucy joined Channel 4’s Hollyoaks in 1999 as Luke Morgan, a role that gave him his first national television audience. Luke’s central storyline in the show became one of the era’s most widely discussed on British soap, handled by the production with the seriousness the subject demanded.',
    'The performance earned Lucy the Best Newcomer award at the 2000 British Soap Awards — the first major recognition of his career, and the credit that established him as a name British audiences would follow across the following decade.',
    'He returned to the role in 2002, and again for a longer run from 2017 to 2023, making Luke Morgan the character Lucy has played, on and off, for longer than any other in his career.',
    'Hollyoaks remains the credit most closely associated with Gary Lucy’s breakthrough, and the role that opened the door to the primetime drama work that followed on ITV and BBC One.',
  ],
  'footballers-wives': [
    'After Hollyoaks, Gary Lucy joined ITV’s Footballers’ Wives as Kyle Pascoe, playing one of the young professional footballers at the centre of the show’s fictional club, Earls Park.',
    'Footballers’ Wives was one of the defining British primetime dramas of the early 2000s — a glossy, high-rating series that took the soap format upmarket and became appointment viewing on ITV.',
    'The role marked Lucy’s move from continuing drama into primetime ensemble television, a transition that set the pattern for the rest of his screen career: long-running parts in some of British television’s highest-profile productions.',
  ],
  'the-bill': [
    'Gary Lucy joined ITV’s The Bill in 2005 as DC Will Fletcher, a CID detective at the show’s fictional Sun Hill station, and stayed with the programme for five years — the longest single run of his career.',
    'The Bill was, for three decades, Britain’s best-known police procedural, and a regular role of this length placed Lucy at the centre of one of ITV’s flagship dramas through the second half of the 2000s.',
    'Five years playing a working CID detective gave Lucy a sustained run in straight procedural drama, distinct from the soap and ensemble roles that had defined his career up to that point.',
  ],
  eastenders: [
    'In 2012, Gary Lucy joined BBC One’s EastEnders as Danny Pennant, a city banker whose storylines ran through the show’s Walford setting until 2014.',
    'The role brought Lucy to BBC One’s flagship continuing drama, and his performance as Danny Pennant earned a Villain of the Year nomination at the 2013 British Soap Awards.',
    'EastEnders sits alongside Hollyoaks, Footballers’ Wives and The Bill as one of the major British television institutions Gary Lucy has been part of across a career now approaching three decades.',
  ],
  'the-good-ship-murder': [
    'Gary Lucy joined the cast of Channel 5’s The Good Ship Murder as Jason Agnew, in the series 3 Christmas Special — Alicante, filmed on location in the Mediterranean and first broadcast 27 December 2025.',
    'The Good Ship Murder is Channel 5’s cruise-ship-set murder-mystery drama, and Lucy’s casting places him in one of the channel’s highest-profile recent commissions.',
    'It continues a run of primetime crime-drama roles that includes The Bill and, since, The Chelsea Detective.',
  ],
  'the-chelsea-detective': [
    'Gary Lucy plays Mike Curtis in the fourth series of The Chelsea Detective, appearing in the series opener, "Death on the Aether." The series streams on Acorn TV — including via the Acorn TV Amazon Prime Video Channel — and is distributed across multiple territories internationally.',
    'The Chelsea Detective is a London-set detective drama built around a straightforward, character-led case format. It is created and executive produced by Peter Fincham through his production company Expectation — Fincham was Controller of BBC One from 2005 to 2007, then Director of Television at ITV from 2008 to 2016, before moving into independent production.',
    'The role continues a screen career that began with Hollyoaks in 1999 — new characters and new productions, applied with nearly three decades of experience.',
  ],
};
const body = bodyFor[role.slug] ?? [role.summary];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Screen', item: absoluteUrl('/screen') },
      { '@type': 'ListItem', position: 3, name: role.show, item: absoluteUrl(`/screen/${role.slug}`) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'TVSeries',
    name: role.show,
    actor: { '@id': `${SITE_URL}/#person` },
  },
];
---
<Layout title={role.seoTitle} description={role.seoDescription} path={`/screen/${role.slug}`} jsonLd={jsonLd}>
  <article class="rs-page">
    <FlipHero
      id={role.slug}
      imageFront={hero}
      imageBack="/hero/gl-jacket-bw-web.jpg"
      altFront={`Gary Lucy as ${role.character} in ${role.show}`}
      altBack="Gary Lucy, black and white studio portrait"
      kicker={`${role.network} · ${role.years} · ${role.type}`}
      headline={`Gary Lucy in ${role.show}`}
      dek={`Playing ${role.character}`}
      backKicker="Character"
      backHeadline={role.character}
    />

    <div class="rs-body">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <a href="/screen">Screen</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">{role.show}</span>
      </nav>

      {body.map((para, i) => i === 0 ? <p class="rs-lede">{para}</p> : <p>{para}</p>)}

      <p>
        <a href="/about" class="accent">Gary Lucy’s full biography &rarr;</a>
      </p>

      <hr class="rs-divider" />
      <a href="/screen" class="rs-eyebrow">&larr; All screen credits</a>
    </div>
  </article>
</Layout>
