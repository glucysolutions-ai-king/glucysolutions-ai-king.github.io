---
import Layout from '../../layouts/Layout.astro';
import FlipHero from '../../components/FlipHero.astro';
import { roles } from '../../data/credits';

const heroFor: Record<string, string> = {
  hollyoaks: '/portraits/gl-standing2-web.jpg',
  'footballers-wives': '/gallery/gary-lucy-jacket-1600.jpg',
  'the-bill': '/gallery/gary-lucy-wing-1600.jpg',
  eastenders: '/portraits/gl-seated2-web.jpg',
  'the-good-ship-murder': '/portraits/gl-walking2-web.jpg',
};
---
<Layout
  title="Gary Lucy — Screen Credits"
  description="Gary Lucy's television credits: Hollyoaks, Footballers' Wives, The Bill, EastEnders and The Good Ship Murder."
  path="/screen"
>
  <article class="rs-page">
    <FlipHero
      id="screen"
      imageFront="/portraits/gl-walking2-web.jpg"
      imageBack="/gallery/gary-lucy-jacket-1600.jpg"
      altFront="Gary Lucy"
      altBack="Gary Lucy on set"
      kicker="Filmography"
      headline="Screen Credits"
      dek="Five shows, five decades of British television &mdash; from teenage soap villain to primetime lead."
      backKicker="On Screen"
      backHeadline="Every Era,<br />One Career"
    />

    <div class="rs-body rs-body-wide">
      <div class="rs-cards">
        {roles.map((role) => (
          <a href={`/screen/${role.slug}`} class="rs-card">
            <img src={heroFor[role.slug] ?? '/hero/gl-standing-bw-web.jpg'} alt={role.show} />
            <div class="rs-card-scrim"></div>
            <div class="rs-card-label">
              <span class="rs-card-eyebrow">{role.network} &middot; {role.years}</span>
              <span class="rs-card-title">{role.show}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </article>
</Layout>
