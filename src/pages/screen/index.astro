---
import Layout from '../../layouts/Layout.astro';
import FlipHero from '../../components/FlipHero.astro';
import { careerTimeline } from '../../data/credits';
---
<Layout
  title="Gary Lucy — Screen Credits"
  description="Gary Lucy's full television career: from Grange Hill and Dream Team through Hollyoaks, Footballers' Wives, The Bill and EastEnders to The Chelsea Detective and The Good Ship Murder."
  path="/screen"
>
  <article class="rs-page">
    <FlipHero
      id="screen"
      imageFront="/gallery/gary-lucy-actor-walking-editorial.jpg"
      imageBack="/gallery/gary-lucy-jacket-1600.jpg"
      altFront="Gary Lucy, British actor, on location"
      altBack="Gary Lucy, close portrait"
      kicker="Filmography"
      headline="Screen Credits"
      dek="Fifteen credits, three decades of British television &mdash; from teenage soap villain to primetime lead."
      backKicker="On Screen"
      backHeadline="Every Era,<br />One Career"
    />

    <div class="rs-body rs-body-wide">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Screen</span>
      </nav>

      <div class="rs-cards">
        {careerTimeline.map((entry) => {
          const Tag = entry.slug ? 'a' : 'div';
          return (
            <Tag {...(entry.slug ? { href: `/screen/${entry.slug}` } : {})} class="rs-card">
              <img src={entry.image} alt={`Gary Lucy as ${entry.character} in ${entry.show}`} loading="lazy" />
              <div class="rs-card-scrim"></div>
              <div class="rs-card-label">
                <span class="rs-card-eyebrow">{entry.network} &middot; {entry.years}</span>
                <span class="rs-card-title">{entry.show}</span>
              </div>
            </Tag>
          );
        })}
      </div>
    </div>
  </article>
</Layout>
