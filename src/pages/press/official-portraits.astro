---
import Layout from '../../layouts/Layout.astro';
import { galleryImages, imageUrl, imagePagePath } from '../../data/gallery';
import { SITE_URL, absoluteUrl } from '../../data/site';

const preferredSlugs = [
  'headshot',
  'headshot-checked-shirt',
  'portrait-white-shirt',
  'red-carpet',
  'seated-aircraft-wreckage-portrait',
  'leather-jacket-portrait',
];
const portraits = preferredSlugs
  .map((slug) => galleryImages.find((image) => image.slug === slug))
  .filter(Boolean);

const pagePath = '/press/official-portraits';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl(`${pagePath}/`)}#webpage`,
    name: 'Gary Lucy — Official Portraits and Press Images',
    url: absoluteUrl(`${pagePath}/`),
    description: 'Selected current portraits and press images of British actor Gary Lucy, with verified credits and links to the official image pages.',
    about: { '@id': `${SITE_URL}/#person` },
    mainEntity: {
      '@type': 'ImageGallery',
      name: 'Gary Lucy official portraits',
      associatedMedia: portraits.map((img) => ({ '@id': `${absoluteUrl(`${imagePagePath(img)}/`)}#image` })),
    },
  },
  ...portraits.map((img) => ({
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    '@id': `${absoluteUrl(`${imagePagePath(img)}/`)}#image`,
    name: `Gary Lucy — ${img.title}`,
    contentUrl: absoluteUrl(imageUrl(img)),
    url: absoluteUrl(`${imagePagePath(img)}/`),
    width: img.width,
    height: img.height,
    caption: img.caption ?? img.alt,
    about: { '@id': `${SITE_URL}/#person` },
    creditText: img.credit ?? 'Gary Lucy — official website',
    acquireLicensePage: absoluteUrl('/contact/'),
  })),
];
---
<Layout
  title="Gary Lucy — Official Portraits &amp; Press Images"
  description="Selected current portraits and press images of British actor Gary Lucy, with verified credits and links to the official high-resolution image pages."
  path={pagePath}
  jsonLd={jsonLd}
  ogImage={imageUrl(portraits[0])}
>
  <article class="rs-page">
    <div class="rs-body rs-body-wide" style="padding-top:6rem;">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <a href="/press">Press</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Official portraits</span>
      </nav>

      <p class="rs-kicker">Media resources</p>
      <h1 class="rs-row-name" style="font-size:clamp(2rem,5vw,3.8rem); line-height:1.05; margin:.35em 0;">
        Gary Lucy official portraits &amp; press images
      </h1>
      <p class="rs-lede" style="max-width:65ch;">
        A selected set of current, professionally presented images of British actor Gary Lucy for editorial reference, casting and legitimate press enquiries. Each portrait links to its canonical image page with dimensions, context and confirmed credit where available.
      </p>

      <div class="rs-cards" style="aspect-ratio:auto; margin-top:2.5rem;">
        {portraits.map((img, index) => (
          <figure class="rs-gallery-figure">
            <a href={imagePagePath(img)} aria-label={`Open the official page for Gary Lucy — ${img.title}`}>
              <img
                src={imageUrl(img)}
                srcset={img.srcset}
                sizes="(max-width: 800px) 100vw, 33vw"
                alt={img.alt}
                width={img.width}
                height={img.height}
                loading={index < 3 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : undefined}
              />
            </a>
            <figcaption class="rs-gallery-caption">
              <a href={imagePagePath(img)}>Gary Lucy &mdash; {img.title}</a>
              {img.credit && <><br /><span>Photo: {img.credit}</span></>}
            </figcaption>
          </figure>
        ))}
      </div>

      <p class="rs-note" style="max-width:70ch; margin-top:2rem;">
        Images remain subject to their respective copyright and usage terms. For publication, licensing or a specific high-resolution file, <a href="/contact">contact Gary Lucy&rsquo;s official representation</a>. More verified photography is available in the <a href="/gallery">official gallery</a>.
      </p>
    </div>
  </article>
</Layout>
