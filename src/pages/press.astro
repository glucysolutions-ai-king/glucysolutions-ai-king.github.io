---
import Layout from '../layouts/Layout.astro';
import FlipHero from '../components/FlipHero.astro';
import { pressItems } from '../data/press';
---
<Layout
  title="Gary Lucy — Press &amp; Interviews"
  description="Press coverage and interviews with Gary Lucy."
  path="/press"
>
  <article class="rs-page">
    <FlipHero
      id="press"
      imageFront="/gallery/gary-lucy-jacket-1600.jpg"
      imageBack="/hero/gl-fuselage-color.jpg"
      altFront="Gary Lucy, British actor, editorial portrait"
      altBack="Gary Lucy on location"
      kicker="Press"
      headline="Press &amp; Interviews"
      dek="Coverage and interviews, curated for professional relevance."
      backKicker="In The Press"
      backHeadline="Read On &raquo;"
    />

    <div class="rs-body">
      <ul class="rs-rows">
        {pressItems.map((item) => (
          <li>
            <span class="rs-row-name"><a href={item.url} target="_blank" rel="noopener">{item.title}</a></span>
            <span class="rs-row-meta">{item.outlet}{item.date ? ` · ${item.date}` : ''} &middot; {item.kind}</span>
          </li>
        ))}
      </ul>
      <p class="rs-note">More coverage added as it's confirmed &mdash; this list is curated for professional relevance, not comprehensiveness.</p>
    </div>
  </article>
</Layout>
