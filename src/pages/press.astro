---
import Layout from '../layouts/Layout.astro';
import { pressItems } from '../data/press';
---
<Layout
  title="Gary Lucy — Press &amp; Interviews"
  description="Press coverage and interviews with Gary Lucy."
  path="/press"
>
  <article class="rs-page">
    <header class="rs-hero rs-hero-sm">
      <img src="/gallery/gary-lucy-jacket-1600.jpg" alt="Gary Lucy, British actor, editorial portrait" class="rs-hero-img" />
      <div class="rs-hero-scrim"></div>
      <div class="rs-hero-content">
        <p class="rs-kicker">Press</p>
        <h1 class="rs-headline">Press &amp; Interviews</h1>
      </div>
    </header>

    <div class="rs-body">
      <ul class="rs-rows">
        {pressItems.map((item) => (
          <li>
            <span class="rs-row-name"><a href={item.url} target="_blank" rel="noopener">{item.title}</a></span>
            <span class="rs-row-meta">{item.outlet}{item.date ? ` · ${item.date}` : ' · date TBC'} &middot; {item.kind}</span>
          </li>
        ))}
      </ul>
      <p class="rs-note">More coverage added as it's confirmed &mdash; this list is curated for professional relevance, not comprehensiveness.</p>
    </div>
  </article>
</Layout>
