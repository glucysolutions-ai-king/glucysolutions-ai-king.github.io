---
import Layout from '../layouts/Layout.astro';
import FlipHero from '../components/FlipHero.astro';
---
<Layout
  title="Contact Gary Lucy"
  description="Representation and press contact for actor Gary Lucy."
  path="/contact"
>
  <article class="rs-page">
    <FlipHero
      id="contact"
      imageFront="/portraits/gl-studio2-web.jpg"
      imageBack="/hero/gl-jacket-bw-web.jpg"
      altFront="Gary Lucy, British actor, studio portrait"
      altBack="Gary Lucy, black and white studio portrait"
      kicker="Contact"
      headline="Get In Touch"
      dek="Representation for casting, production and press enquiries."
      backKicker="Direct Line"
      backHeadline="Agent &amp;<br />Manager"
    />

    <div class="rs-body">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Contact</span>
      </nav>

      <ul class="rs-rows">
        <li>
          <div>
            <span class="rs-row-name">Acting Enquiries</span>
            <p style="font-family:'Helvetica Neue',Arial,sans-serif; font-size:0.85rem; color:var(--rs-meta); margin:0.3em 0 0;">
              Lee Morgan &mdash; Lee Morgan Management
            </p>
          </div>
          <span class="rs-row-meta"><a href="mailto:lee@leemorgan.biz" class="accent">lee@leemorgan.biz</a></span>
        </li>
        <li>
          <div>
            <span class="rs-row-name">Management &amp; Press Enquiries</span>
            <p style="font-family:'Helvetica Neue',Arial,sans-serif; font-size:0.85rem; color:var(--rs-meta); margin:0.3em 0 0;">
              Claire Powell &mdash; CAN Associates
            </p>
          </div>
        </li>
      </ul>
    </div>
  </article>
</Layout>
