---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact Gary Lucy"
  description="Professional contact and enquiries for Gary Lucy."
  path="/contact"
>
  <article class="rs-page">
    <header class="rs-hero rs-hero-sm">
      <img src="/portraits/gl-studio2-web.jpg" alt="Gary Lucy" class="rs-hero-img" />
      <div class="rs-hero-scrim"></div>
      <div class="rs-hero-content">
        <p class="rs-kicker">Contact</p>
        <h1 class="rs-headline">Get In Touch</h1>
      </div>
    </header>

    <div class="rs-body">
      <p class="rs-lede">
        Representation is currently under review &mdash; this page intentionally does not list
        an agent while that's decided. Casting, production and press enquiries can be sent
        directly using the form below.
      </p>

      <!--
        [INPUT NEEDED]: this posts to Formspree's free tier, which needs a one-time
        sign-up at formspree.io to get a real form ID. Swap YOUR_FORM_ID below, or
        replace the whole form with a mailto: link once representation is settled.
        Either way, no paid hosting is required.
      -->
      <form action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="rs-form">
        <label>
          Name
          <input type="text" name="name" required />
        </label>
        <label>
          Email
          <input type="email" name="email" required />
        </label>
        <label>
          Enquiry type
          <select name="type">
            <option>Casting / production</option>
            <option>Press / interview</option>
            <option>Brand / commercial</option>
            <option>Other</option>
          </select>
        </label>
        <label>
          Message
          <textarea name="message" rows="5" required></textarea>
        </label>
        <button type="submit" class="rs-btn">Send</button>
      </form>
    </div>
  </article>
</Layout>
