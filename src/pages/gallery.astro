---
import Layout from '../layouts/Layout.astro';
import FlipHero from '../components/FlipHero.astro';
import { galleryImages } from '../data/gallery';

const jsonLd = galleryImages.map((img) => ({
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: `https://www.garylucy.co.uk/gallery/${img.file}`,
  name: img.alt,
  caption: img.caption ?? img.alt,
}));
---
<Layout
  title="Gary Lucy — Gallery"
  description="Casting photography and press imagery for Gary Lucy."
  path="/gallery"
  jsonLd={jsonLd}
>
  <article class="rs-page">
    <FlipHero
      id="gallery"
      imageFront="/gallery/gary-lucy-sitting-1600.jpg"
      imageBack="/gallery/gary-lucy-wing-1600.jpg"
      altFront="Gary Lucy, British actor, black and white editorial portrait"
      altBack="Gary Lucy on location"
      kicker="Gallery"
      headline="Gallery"
      dek="Casting photography and press imagery."
      backKicker="On Set"
      backHeadline="Every Angle"
    />

    <div class="rs-body rs-body-wide">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Gallery</span>
      </nav>

      {galleryImages.length === 0 ? (
        <p class="rs-note" style="margin:0;">
          <strong>No images yet.</strong> Upload casting photos and they're added here automatically.
        </p>
      ) : (
        <div class="rs-cards" style="aspect-ratio:auto;">
          {galleryImages.map((img) => (
            <figure class="rs-gallery-figure">
              <img
                src={`/gallery/${img.file}`}
                srcset={img.srcset}
                sizes="(max-width: 800px) 100vw, 33vw"
                alt={img.alt}
                loading="lazy"
              />
              {img.caption && <figcaption class="rs-gallery-caption">{img.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </div>
  </article>
</Layout>
