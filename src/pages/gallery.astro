---
import Layout from '../layouts/Layout.astro';
import FlipHero from '../components/FlipHero.astro';
import { galleryImages, imageUrl, imagePagePath } from '../data/gallery';
import { SITE_URL, absoluteUrl } from '../data/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl('/gallery/')}#gallery`,
    name: 'Gary Lucy — Official Photo Gallery',
    url: absoluteUrl('/gallery/'),
    about: { '@id': `${SITE_URL}/#person` },
    hasPart: galleryImages.map((img) => ({ '@id': `${absoluteUrl(`${imagePagePath(img)}/`)}#image` })),
  },
  ...galleryImages.map((img) => ({
    '@context': 'https://schema.org',
    '@type': 'ImageObject',
    '@id': `${absoluteUrl(`${imagePagePath(img)}/`)}#image`,
    contentUrl: absoluteUrl(imageUrl(img)),
    url: absoluteUrl(imageUrl(img)),
    width: img.width,
    height: img.height,
    name: `Gary Lucy — ${img.title}`,
    caption: img.caption ?? img.alt,
    mainEntityOfPage: absoluteUrl(`${imagePagePath(img)}/`),
    about: { '@id': `${SITE_URL}/#person` },
    acquireLicensePage: absoluteUrl('/contact/'),
    creditText: img.credit ?? 'Gary Lucy — official website',
  })),
];
---
<Layout
  title="Gary Lucy — Gallery"
  description="Casting photography and press imagery for Gary Lucy."
  path="/gallery"
  jsonLd={jsonLd}
>
  <article class="rs-page">
    <FlipHero
      id="gallery"
      imageFront="/gallery/gary-lucy-sitting-1600.jpg"
      imageBack="/gallery/gary-lucy-wing-1600.jpg"
      altFront="Gary Lucy, British actor, black and white editorial portrait"
      altBack="Gary Lucy on location"
      kicker="Gallery"
      headline="Gallery"
      dek="Casting photography and press imagery."
      backKicker="On Set"
      backHeadline="Every Angle"
    />

    <div class="rs-body rs-body-wide">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Gallery</span>
      </nav>

      {galleryImages.length === 0 ? (
        <p class="rs-note" style="margin:0;">
          <strong>No images yet.</strong> Upload casting photos and they're added here automatically.
        </p>
      ) : (
        <div class="rs-cards" style="aspect-ratio:auto;">
          {galleryImages.map((img, i) => (
            <figure class="rs-gallery-figure">
              <a href={imagePagePath(img)} aria-label={`Gary Lucy — ${img.title}`}>
                <img
                  src={imageUrl(img)}
                  srcset={img.srcset}
                  sizes="(max-width: 800px) 100vw, 33vw"
                  alt={img.alt}
                  width={img.width}
                  height={img.height}
                  loading={i < 4 ? 'eager' : 'lazy'}
                />
              </a>
              <figcaption class="rs-gallery-caption">{img.caption ?? img.title}</figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </article>
</Layout>
