---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Gary Lucy — News"
  description="Latest professional news from Gary Lucy."
  path="/news"
>
  <section class="container" style="padding: 6rem 1.5rem 4rem;">
    <p class="eyebrow">News</p>
    <h1>News</h1>
    <div class="card" style="max-width:640px;">
      <p><strong>Latest:</strong> Gary Lucy joins the cast of Channel 5's <em>The Good Ship Murder</em>, series 3, as Jason Agnew.</p>
    </div>
    <p style="margin-top:2rem; font-size:0.85rem; color:var(--fg-muted);">Further updates posted here as they're confirmed.</p>
  </section>
</Layout>
