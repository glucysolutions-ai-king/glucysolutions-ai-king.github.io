---
import Layout from '../layouts/Layout.astro';
import FlipHero from '../components/FlipHero.astro';
---
<Layout
  title="Gary Lucy — News"
  description="Latest professional news from Gary Lucy."
  path="/news"
>
  <article class="rs-page">
    <FlipHero
      id="news"
      imageFront="/hero/gl-sitting-bw-web.jpg"
      imageBack="/gallery/gary-lucy-fuselage-1600.jpg"
      altFront="Gary Lucy, British actor"
      altBack="Gary Lucy on location"
      kicker="News"
      headline="Latest News"
      dek="Updates on Gary's current and upcoming work."
      backKicker="Breaking"
      backHeadline="Stay Tuned"
    />

    <div class="rs-body">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">News</span>
      </nav>

      <ul class="rs-rows">
        <li>
          <div>
            <span class="rs-row-name">The Good Ship Murder, Series 3</span>
            <p style="font-family:'Helvetica Neue',Arial,sans-serif; font-size:0.85rem; color:var(--rs-meta); margin:0.3em 0 0;">
              Gary Lucy joins the cast of Channel 5's <em>The Good Ship Murder</em> as Jason Agnew.
            </p>
          </div>
          <span class="rs-row-meta">Channel 5</span>
        </li>
      </ul>
      <p class="rs-note">Further updates posted here as they're confirmed.</p>
    </div>
  </article>
</Layout>
