---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page Not Found | Gary Lucy"
  description="This page could not be found on Gary Lucy's official website."
  path="/404"
>
  <article class="rs-page">
    <div class="rs-body" style="padding-top: clamp(6rem, 14vw, 9rem); text-align: center;">
      <p class="rs-eyebrow">404</p>
      <h1 style="font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2rem, 6vw, 3rem); margin: 0.3em 0;">
        Page Not Found
      </h1>
      <p class="rs-lede" style="margin: 0 auto 2em;">
        The page you're looking for doesn't exist, or has moved.
      </p>
      <p>
        <a href="/" class="accent">Return to the homepage</a> &middot;
        <a href="/screen" class="accent">Screen credits</a> &middot;
        <a href="/about" class="accent">Biography</a>
      </p>
    </div>
  </article>
</Layout>
