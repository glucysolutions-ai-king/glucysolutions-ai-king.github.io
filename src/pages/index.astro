---
import Layout from '../layouts/Layout.astro';
import MagazineHero from '../components/MagazineHero.astro';
import { careerTimeline } from '../data/credits';
import { SITE_URL, absoluteUrl } from '../data/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${SITE_URL}/#webpage`,
    url: `${SITE_URL}/`,
    name: 'Gary Lucy — Official Site | British Screen & Stage Actor',
    dateCreated: '2026-09-20',
    dateModified: '2026-11-07',
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: { '@id': `${SITE_URL}/#person` },
    mainEntity: { '@id': `${SITE_URL}/#person` },
    primaryImageOfPage: absoluteUrl('/gallery/gary-lucy-actor-headshot-dark-1200.jpg'),
  },
];
---
<Layout
  title="Gary Lucy — Official Site | British Screen &amp; Stage Actor"
  description="Official site of Gary Lucy: nearly three decades on British screen and stage, from Hollyoaks and Footballers' Wives to The Chelsea Detective."
  path="/"
  jsonLd={jsonLd}
>
  <MagazineHero
    imageFull="/hero/gary-lucy-actor-full-length-black-white.jpg"
    imageClose="/hero/gary-lucy-actor-close-up-black-white.jpg"
    altFull="Gary Lucy, full-length black and white editorial portrait"
    altClose="Gary Lucy, close-up black and white editorial portrait"
  />

  <section class="container" style="padding: 5rem 1.5rem;">
    <p class="eyebrow">Currently</p>
    <h2>The Chelsea Detective</h2>
    <p style="max-width: 60ch;">Gary appears as Michael Curtis in "Death on the Aether," the opening episode of series four of The Chelsea Detective, streaming on Acorn TV.</p>
    <a href="/screen/the-chelsea-detective" class="accent">Read more &rarr;</a>
  </section>

  <section class="container official-portraits" aria-labelledby="official-portraits-heading">
    <div class="portrait-intro">
      <div>
        <p class="eyebrow">Official images</p>
        <h2 id="official-portraits-heading">Gary Lucy — 2026 portrait selection</h2>
      </div>
      <p>
        Current, verified portraits supplied by Gary Lucy's official website for
        editorial identification and authorised media enquiries.
        <a href="/press/official-portraits/" class="accent">View the press image hub &rarr;</a>
      </p>
    </div>
    <div class="portrait-grid">
      <a href="/gallery/headshot/">
        <img src="/gallery/gary-lucy-actor-headshot-dark-1200.jpg" alt="Gary Lucy, British actor, official 2026 headshot against a dark background" width="1170" height="1322" loading="lazy" decoding="async" />
        <span>Official actor headshot</span>
      </a>
      <a href="/gallery/headshot-checked-shirt/">
        <img src="/gallery/gary-lucy-actor-headshot-checked-shirt-1200.jpg" alt="Gary Lucy, British actor, official 2026 headshot in a blue checked shirt" width="1170" height="1328" loading="lazy" decoding="async" />
        <span>Checked-shirt headshot</span>
      </a>
      <a href="/gallery/portrait-white-shirt/">
        <img src="/gallery/gary-lucy-actor-portrait-white-shirt-1200.jpg" alt="Gary Lucy, British actor, official 2026 portrait in a white shirt and blue tie" width="1170" height="1222" loading="lazy" decoding="async" />
        <span>White-shirt portrait</span>
      </a>
    </div>
  </section>

  <section class="container" style="padding-bottom: 5rem;">
    <p class="eyebrow">Selected credits</p>
    <ul class="role-list">
      {careerTimeline.map((entry) => (
        <li>
          <div>
            <strong>{entry.character}</strong> —{' '}
            {entry.slug ? <a href={`/screen/${entry.slug}`}>{entry.show}</a> : entry.show}
          </div>
          <span class="years">{entry.years}</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .official-portraits {
    padding: 0 1.5rem 5rem;
  }

  .portrait-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.75rem;
  }

  .portrait-intro p:last-child {
    margin: 0;
    max-width: 52ch;
  }

  .portrait-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .portrait-grid a {
    color: inherit;
    text-decoration: none;
  }

  .portrait-grid img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #111;
  }

  .portrait-grid span {
    display: block;
    padding-top: 0.65rem;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 720px) {
    .portrait-intro {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .portrait-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
