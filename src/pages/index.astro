---
import Layout from '../layouts/Layout.astro';
import MagazineHero from '../components/MagazineHero.astro';
import { careerTimeline } from '../data/credits';
import { SITE_URL, absoluteUrl } from '../data/site';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${SITE_URL}/#webpage`,
    url: `${SITE_URL}/`,
    name: 'Gary Lucy | Official Website of the British Actor',
    dateCreated: '2026-09-20',
    dateModified: '2026-11-09',
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: { '@id': `${SITE_URL}/#person` },
    mainEntity: { '@id': `${SITE_URL}/#person` },
    primaryImageOfPage: absoluteUrl('/gallery/gary-lucy-actor-headshot-dark-1200.jpg'),
  },
];
---
<Layout
  title="Gary Lucy | Official Website of the British Actor"
  description="Gary Lucy's official website. Explore the award-winning British actor's biography, filmography, television roles, current work and official portraits."
  path="/"
  jsonLd={jsonLd}
>
  <MagazineHero
    imageFull="/hero/gary-lucy-actor-full-length-black-white.jpg"
    imageClose="/hero/gary-lucy-actor-close-up-black-white.jpg"
    altFull="Gary Lucy, full-length black and white editorial portrait"
    altClose="Gary Lucy, close-up black and white editorial portrait"
  />

  <section class="container identity-intro" aria-labelledby="gary-lucy-actor-heading">
    <p class="eyebrow">Official biography</p>
    <h2 id="gary-lucy-actor-heading">Gary Lucy — award-winning British actor</h2>
    <p class="identity-lede">
      Gary Lucy is an English screen and stage actor whose professional career
      has run from <em>Grange Hill</em> and <em>Dream Team</em> in 1997 through
      major roles in <em>Hollyoaks</em>, <em>Footballers&rsquo; Wives</em>,
      <em>The Bill</em> and <em>EastEnders</em> to current British crime drama.
      He won Best Newcomer at the 2000 British Soap Awards for playing Luke Morgan.
    </p>
    <p>
      This is Gary Lucy&rsquo;s official website and the canonical source for his
      <a href="/about/">professional biography</a>,
      <a href="/filmography/">complete film and television credits</a>,
      <a href="/press/">verified press coverage</a> and
      <a href="/gallery/">official photography</a>.
    </p>
    <nav class="identity-links" aria-label="Gary Lucy career highlights">
      <a href="/screen/hollyoaks/">Hollyoaks</a>
      <a href="/screen/footballers-wives/">Footballers&rsquo; Wives</a>
      <a href="/screen/the-bill/">The Bill</a>
      <a href="/screen/eastenders/">EastEnders</a>
      <a href="/screen/the-good-ship-murder/">The Good Ship Murder</a>
      <a href="/screen/the-chelsea-detective/">The Chelsea Detective</a>
    </nav>
    <p class="professional-profile">
      Casting professionals can also view Gary Lucy&rsquo;s verified
      <a href="https://app.spotlight.com/2933-0161-4591" target="_blank" rel="me noopener">Spotlight performer profile</a>.
    </p>
  </section>

  <section class="container" style="padding: 5rem 1.5rem;">
    <p class="eyebrow">Currently</p>
    <h2>The Chelsea Detective</h2>
    <p style="max-width: 60ch;">Gary appears as Michael Curtis in "Death on the Aether," the opening episode of series four of The Chelsea Detective, streaming on Acorn TV.</p>
    <a href="/screen/the-chelsea-detective" class="accent">Read more &rarr;</a>
  </section>

  <section class="container official-portraits" aria-labelledby="official-portraits-heading">
    <div class="portrait-intro">
      <div>
        <p class="eyebrow">Official images</p>
        <h2 id="official-portraits-heading">Gary Lucy — 2026 portrait selection</h2>
      </div>
      <p>
        Current, verified portraits supplied by Gary Lucy's official website for
        editorial identification and authorised media enquiries.
        <a href="/press/official-portraits/" class="accent">View the press image hub &rarr;</a>
      </p>
    </div>
    <div class="portrait-grid">
      <a href="/gallery/official-close-up-dark-coat-2026/">
        <img src="/gallery/gary-lucy-british-actor-close-up-dark-coat-2026-512.jpg" alt="Gary Lucy, British actor, official 2026 close-up portrait in a dark coat" width="512" height="1024" loading="lazy" decoding="async" />
        <span>Official close-up portrait</span>
      </a>
      <a href="/gallery/instagram-headshot-dan-collins-2026/">
        <img src="/gallery/gary-lucy-instagram-headshot-dan-collins-2026-480.jpg" alt="Gary Lucy, British actor, official 2026 black-and-white portrait in a white T-shirt" width="480" height="640" loading="lazy" decoding="async" />
        <span>White T-shirt portrait</span>
      </a>
      <a href="/gallery/headshot-checked-shirt/">
        <img src="/gallery/gary-lucy-actor-headshot-checked-shirt-1200.jpg" alt="Gary Lucy, British actor, official 2026 headshot in a blue checked shirt" width="1170" height="1328" loading="lazy" decoding="async" />
        <span>Checked-shirt headshot</span>
      </a>
      <a href="/gallery/brown-leather-jacket-headshot-2026/">
        <img src="/gallery/gary-lucy-brown-leather-jacket-headshot-2026-360.jpg" alt="Gary Lucy, British actor, official 2026 headshot in a brown leather jacket" width="360" height="640" loading="lazy" decoding="async" />
        <span>Brown leather-jacket headshot</span>
      </a>
    </div>
    <nav class="portrait-links" aria-label="More official Gary Lucy portraits">
      <span>More official portraits:</span>
      <a href="/gallery/leather-jacket-portrait/">leather-jacket portrait</a>
      <a href="/gallery/red-carpet/">red-carpet portrait</a>
      <a href="/gallery/standing-editorial-portrait/">full-length editorial portrait</a>
      <a href="/gallery/seated-aircraft-wreckage-portrait/">seated editorial portrait</a>
    </nav>
  </section>

  <section class="container" style="padding-bottom: 5rem;">
    <p class="eyebrow">Selected credits</p>
    <ul class="role-list">
      {careerTimeline.map((entry) => (
        <li>
          <div>
            <strong>{entry.character}</strong> —{' '}
            {entry.slug ? <a href={`/screen/${entry.slug}`}>{entry.show}</a> : entry.show}
          </div>
          <span class="years">{entry.years}</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .identity-intro {
    padding: 5rem 1.5rem 2rem;
    max-width: 920px;
  }

  .identity-intro h2 {
    max-width: 22ch;
    margin-bottom: 1.25rem;
  }

  .identity-lede {
    max-width: 72ch;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.65;
  }

  .identity-intro > p:not(.eyebrow) {
    max-width: 76ch;
  }

  .identity-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }

  .identity-links a {
    border: 1px solid currentColor;
    padding: 0.55rem 0.8rem;
    color: inherit;
    text-decoration: none;
  }

  .identity-links a:hover,
  .identity-links a:focus-visible {
    color: var(--accent);
  }

  .professional-profile {
    margin-top: 1.4rem;
  }

  .official-portraits {
    width: 100%;
    min-width: 0;
    padding: 0 1.5rem 5rem;
    overflow: clip;
  }

  .portrait-intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.75rem;
  }

  .portrait-intro p:last-child {
    margin: 0;
    max-width: 52ch;
  }

  .portrait-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    min-width: 0;
  }

  .portrait-grid a {
    display: block;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
  }

  .portrait-grid img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #111;
  }

  .portrait-grid span {
    display: block;
    padding-top: 0.65rem;
    font-size: 0.9rem;
    letter-spacing: 0.04em;
  }

  .portrait-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-top: 1.4rem;
    font-size: 0.9rem;
  }

  .portrait-links a {
    color: inherit;
  }

  @media (max-width: 720px) {
    .official-portraits {
      padding-inline: 1rem;
    }

    .portrait-intro {
      grid-template-columns: 1fr;
      gap: 0.75rem;
      min-width: 0;
    }

    .portrait-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
