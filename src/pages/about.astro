---
import Layout from '../layouts/Layout.astro';
import FlipHero from '../components/FlipHero.astro';
import { profile, awards } from '../data/credits';
---
<Layout
  title="About Gary Lucy | Biography"
  description="Gary Lucy's professional biography: three decades of British screen and stage work, from Hollyoaks to The Good Ship Murder."
  path="/about"
>
  <article class="rs-page">
    <FlipHero
      id="about"
      imageFront="/hero/gl-standing-bw-web.jpg"
      imageBack="/hero/gl-closeup-bw-web.jpg"
      altFront="Gary Lucy, British actor, standing portrait"
      altBack="Gary Lucy, close portrait"
      kicker="Biography"
      headline="Three Decades Across<br />British Screen &amp; Stage"
      dek="From Grange Hill to primetime crime drama &mdash; nearly thirty years of British television and theatre work."
      backKicker="The Full Story"
      backHeadline="Read On &raquo;"
    />

    <div class="rs-body">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">About</span>
      </nav>

      <div class="rs-byline">
        <span>By The Editors</span>
        <span>{new Date().getFullYear()}</span>
      </div>

      <p class="rs-lede">{profile.bioShort}</p>

      <p>
        Lucy began his career with early television work in <em>Grange Hill</em> and
        <em>Dream Team</em> before landing the role that made his name: Luke Morgan
        in Channel 4's <em>Hollyoaks</em>, a performance that won him Best Newcomer
        at the 2000 British Soap Awards. He went on to major roles in
        <em>Footballers' Wives</em>, <em>The Bill</em> and <em>EastEnders</em>,
        building one of the most recognisable careers in British popular drama.
      </p>

      <p>
        On stage, Lucy played Gaz in the UK touring production of
        <em>The Full Monty</em>. Recent screen work includes Jason Agnew in
        Channel 5's <em>The Good Ship Murder</em> and Mike Curtis in series
        four of <em>The Chelsea Detective</em>.
      </p>

      <hr class="rs-divider" />

      <h2 class="rs-section-title">Recognition</h2>
      <ul class="rs-rows">
        {awards.map((a) => (
          <li>
            <span class="rs-row-name">{a.category}</span>
            <span class="rs-row-meta">{a.name} &middot; {a.year} &middot; {a.result}</span>
          </li>
        ))}
      </ul>
    </div>
  </article>
</Layout>
