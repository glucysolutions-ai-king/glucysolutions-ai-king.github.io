---
import Layout from '../layouts/Layout.astro';
import FlipHero from '../components/FlipHero.astro';
import { absoluteUrl } from '../data/site';

// [VERIFY / INPUT NEEDED]: replace with Gary's actual showreel video ID once supplied.
const VIMEO_ID = ''; // e.g. '123456789'
const YOUTUBE_ID = ''; // e.g. 'dQw4w9WgXcQ'

const jsonLd = VIMEO_ID || YOUTUBE_ID
  ? [{
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: 'Gary Lucy — Showreel',
      description: "Gary Lucy's acting showreel.",
      uploadDate: '2026-09-20',
      thumbnailUrl: absoluteUrl('/hero/gary-lucy-actor-full-length-black-white.jpg'), // TODO: swap for a real showreel thumbnail once the video is embedded
      embedUrl: YOUTUBE_ID
        ? `https://www.youtube.com/embed/${YOUTUBE_ID}`
        : `https://player.vimeo.com/video/${VIMEO_ID}`,
    }]
  : [];
---
<Layout
  title="Gary Lucy Showreel &amp; Screen Work | British Actor"
  description="Gary Lucy showreel and current screen work, including The Chelsea Detective, The Good Ship Murder, EastEnders, The Bill and Hollyoaks."
  path="/showreel"
  jsonLd={jsonLd}
>
  <article class="rs-page">
    <FlipHero
      id="showreel"
      imageFront="/gallery/gary-lucy-actor-walking-editorial.jpg"
      imageBack="/gallery/gary-lucy-actor-seated-editorial.jpg"
      altFront="Gary Lucy walking, portrait for his acting showreel"
      altBack="Gary Lucy, seated portrait"
      kicker="Reel"
      headline="Showreel"
      backKicker="Watch"
      backHeadline="Press Play"
    />

    <div class="rs-body">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Showreel</span>
      </nav>

      {YOUTUBE_ID || VIMEO_ID ? (
        <div style="aspect-ratio:16/9; max-width:900px;">
          <iframe
            width="100%"
            height="100%"
            src={YOUTUBE_ID ? `https://www.youtube.com/embed/${YOUTUBE_ID}` : `https://player.vimeo.com/video/${VIMEO_ID}`}
            title="Gary Lucy Showreel"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      ) : (
        <div>
          <p class="rs-lede">
            Gary Lucy is an award-winning British actor with nearly three decades
            across primetime television, streaming drama and UK theatre. A new
            professional showreel is in production.
          </p>
          <p>
            Recent screen work includes Michael Curtis in
            <a href="/screen/the-chelsea-detective/">Acorn TV&rsquo;s <em>The Chelsea Detective</em></a>
            and Jason Agnew in
            <a href="/screen/the-good-ship-murder/">Channel 5&rsquo;s <em>The Good Ship Murder</em></a>.
            Established roles include Danny Pennant in
            <a href="/screen/eastenders/"><em>EastEnders</em></a>, DC Will Fletcher in
            <a href="/screen/the-bill/"><em>The Bill</em></a> and Luke Morgan in
            <a href="/screen/hollyoaks/"><em>Hollyoaks</em></a>.
          </p>
          <p>
            View Gary&rsquo;s <a href="/filmography/">complete filmography</a>,
            <a href="https://app.spotlight.com/2933-0161-4591" target="_blank" rel="me noopener">verified Spotlight profile</a>
            or <a href="/contact/">contact his professional representation</a>.
          </p>
        </div>
      )}
    </div>
  </article>
</Layout>
