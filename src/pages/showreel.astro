---
import Layout from '../layouts/Layout.astro';
import FlipHero from '../components/FlipHero.astro';

// [VERIFY / INPUT NEEDED]: replace with Gary's actual showreel video ID once supplied.
const VIMEO_ID = ''; // e.g. '123456789'
const YOUTUBE_ID = ''; // e.g. 'dQw4w9WgXcQ'

const jsonLd = VIMEO_ID || YOUTUBE_ID
  ? [{
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: 'Gary Lucy — Showreel',
      description: "Gary Lucy's acting showreel.",
      uploadDate: '2026-09-20',
      thumbnailUrl: 'https://www.garylucy.co.uk/hero/gl-standing-bw-web.jpg', // TODO: swap for a real showreel thumbnail once the video is embedded
      embedUrl: YOUTUBE_ID
        ? `https://www.youtube.com/embed/${YOUTUBE_ID}`
        : `https://player.vimeo.com/video/${VIMEO_ID}`,
    }]
  : [];
---
<Layout
  title="Gary Lucy — Showreel"
  description="Watch Gary Lucy's acting showreel."
  path="/showreel"
  jsonLd={jsonLd}
>
  <article class="rs-page">
    <FlipHero
      id="showreel"
      imageFront="/portraits/gl-walking2-web.jpg"
      imageBack="/portraits/gl-seated2-web.jpg"
      altFront="Gary Lucy walking, portrait for his acting showreel"
      altBack="Gary Lucy, seated portrait"
      kicker="Reel"
      headline="Showreel"
      backKicker="Watch"
      backHeadline="Press Play"
    />

    <div class="rs-body">
      <nav class="rs-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">&rsaquo;</span>
        <span aria-current="page">Showreel</span>
      </nav>

      {YOUTUBE_ID || VIMEO_ID ? (
        <div style="aspect-ratio:16/9; max-width:900px;">
          <iframe
            width="100%"
            height="100%"
            src={YOUTUBE_ID ? `https://www.youtube.com/embed/${YOUTUBE_ID}` : `https://player.vimeo.com/video/${VIMEO_ID}`}
            title="Gary Lucy Showreel"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        </div>
      ) : (
        <p class="rs-note" style="margin:0;">
          A new professional showreel is in production. In the meantime, see Gary's
          <a href="/screen" class="accent">television credits</a> and
          <a href="/stage" class="accent">stage work</a>.
        </p>
      )}
    </div>
  </article>
</Layout>
