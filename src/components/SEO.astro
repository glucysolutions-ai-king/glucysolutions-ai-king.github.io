---
import { profile } from '../data/credits';

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/" or "/roles/hollyoaks"
  jsonLd?: object[];
  ogImage?: string;
}

const { title, description, path, jsonLd = [], ogImage = '/hero/gl-standing-bw-web.jpg' } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const ogUrl = new URL(ogImage, Astro.site).toString();

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://www.garylucy.co.uk/#person',
  name: profile.name,
  alternateName: profile.fullName,
  birthDate: profile.born,
  birthPlace: profile.birthPlace,
  jobTitle: 'Actor',
  description: profile.bioShort,
  url: 'https://www.garylucy.co.uk/',
  sameAs: profile.sameAs,
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://www.garylucy.co.uk/#website',
  name: 'Gary Lucy — Official Site',
  url: 'https://www.garylucy.co.uk/',
  about: { '@id': 'https://www.garylucy.co.uk/#person' },
  publisher: { '@id': 'https://www.garylucy.co.uk/#person' },
};

// Auto-generate a simple Home > Page breadcrumb for any top-level page that
// doesn't already supply its own (e.g. screen/[slug].astro supplies a
// three-level Home > Screen > Role breadcrumb itself — never generate a
// second, conflicting one for those).
const hasOwnBreadcrumb = jsonLd.some((e: any) => e['@type'] === 'BreadcrumbList');
const pageLabels: Record<string, string> = {
  '/about': 'About',
  '/screen': 'Screen',
  '/stage': 'Stage',
  '/showreel': 'Showreel',
  '/gallery': 'Gallery',
  '/press': 'Press',
  '/contact': 'Contact',
  '/news': 'News',
};
const autoBreadcrumbLd =
  !hasOwnBreadcrumb && pageLabels[path]
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.garylucy.co.uk/' },
          { '@type': 'ListItem', position: 2, name: pageLabels[path], item: canonical },
        ],
      }
    : null;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="profile" />
<meta property="og:site_name" content="Gary Lucy — Official" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
{autoBreadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(autoBreadcrumbLd)} />}
{jsonLd.map((entry) => (
  <script type="application/ld+json" set:html={JSON.stringify(entry)} />
))}
