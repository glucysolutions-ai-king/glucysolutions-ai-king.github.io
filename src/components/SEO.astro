---
import { profile } from '../data/credits';
import { SITE_URL, absoluteUrl } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/" or "/roles/hollyoaks"
  jsonLd?: object[];
  ogImage?: string;
}

const { title, description, path, jsonLd = [], ogImage = '/hero/gary-lucy-actor-full-length-black-white.jpg' } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const ogUrl = new URL(ogImage, Astro.site).toString();
const imageAlt = title.startsWith('Gary Lucy') ? title : `Gary Lucy — ${title}`;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: profile.name,
  alternateName: profile.fullName,
  birthDate: profile.born,
  birthPlace: profile.birthPlace,
  jobTitle: 'Actor',
  description: profile.bioShort,
  url: `${SITE_URL}/`,
  image: {
    '@type': 'ImageObject',
    url: absoluteUrl('/hero/gary-lucy-actor-full-length-black-white.jpg'),
    contentUrl: absoluteUrl('/hero/gary-lucy-actor-full-length-black-white.jpg'),
    width: 1400,
    height: 2100,
    caption: 'Gary Lucy, British screen and stage actor',
    representativeOfPage: true,
  },
  sameAs: profile.sameAs,
  award: 'British Soap Award for Best Newcomer (2000)',
  knowsAbout: ['Acting', 'British television drama', 'British theatre'],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Gary Lucy — Official Site',
  url: `${SITE_URL}/`,
  about: { '@id': `${SITE_URL}/#person` },
  publisher: { '@id': `${SITE_URL}/#person` },
};

// Auto-generate a simple Home > Page breadcrumb for any top-level page that
// doesn't already supply its own (e.g. screen/[slug].astro supplies a
// three-level Home > Screen > Role breadcrumb itself — never generate a
// second, conflicting one for those).
const hasOwnBreadcrumb = jsonLd.some((e: any) => e['@type'] === 'BreadcrumbList');
const pageLabels: Record<string, string> = {
  '/about': 'About',
  '/screen': 'Screen',
  '/stage': 'Stage',
  '/showreel': 'Showreel',
  '/gallery': 'Gallery',
  '/press': 'Press',
  '/contact': 'Contact',
  '/news': 'News',
  '/news/current-screen-work-2026': 'Current screen work',
};
const autoBreadcrumbLd =
  !hasOwnBreadcrumb && pageLabels[path]
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
          { '@type': 'ListItem', position: 2, name: pageLabels[path], item: canonical },
        ],
      }
    : null;

// A minimal WebPage entity per page, tying it into the WebSite + Person
// entity graph. AboutPage is used for /about specifically (a more precise
// subtype than the generic WebPage); every other page gets plain WebPage.
// Skipped when the page already supplies its own *Page entity (e.g. the
// homepage's ProfilePage in index.astro) to avoid two conflicting
// page-level entities describing the same URL.
const hasOwnPageEntity = jsonLd.some((e: any) => typeof e['@type'] === 'string' && e['@type'].endsWith('Page'));
const webPageLd = !hasOwnPageEntity
  ? {
      '@context': 'https://schema.org',
      '@type': path === '/about' ? 'AboutPage' : 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': `${SITE_URL}/#person` },
      primaryImageOfPage: ogUrl,
    }
  : null;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Gary Lucy — Official" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
{webPageLd && <script type="application/ld+json" set:html={JSON.stringify(webPageLd)} />}
{autoBreadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(autoBreadcrumbLd)} />}
{jsonLd.map((entry) => (
  <script type="application/ld+json" set:html={JSON.stringify(entry)} />
))}
