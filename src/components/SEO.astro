---
import { profile } from '../data/credits';
import { SITE_URL, absoluteUrl } from '../data/site';

interface Props {
  title: string;
  description: string;
  path: string; // e.g. "/" or "/roles/hollyoaks"
  jsonLd?: object[];
  ogImage?: string;
}

const { title, description, path, jsonLd = [], ogImage = '/gallery/gary-lucy-actor-headshot-dark-1200.jpg' } = Astro.props;
const canonicalPath = path === '/' ? '/' : `${path.replace(/\/$/, '')}/`;
const canonical = new URL(canonicalPath, Astro.site).toString();
const ogUrl = new URL(ogImage, Astro.site).toString();
const imageAlt = title.startsWith('Gary Lucy') ? title : `Gary Lucy — ${title}`;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${SITE_URL}/#person`,
  name: profile.name,
  alternateName: profile.fullName,
  birthDate: profile.born,
  birthPlace: profile.birthPlace,
  jobTitle: 'Actor',
  description: profile.bioShort,
  url: `${SITE_URL}/`,
  image: [
    {
      '@type': 'ImageObject',
      '@id': `${absoluteUrl('/gallery/headshot/')}#image`,
      url: absoluteUrl('/gallery/gary-lucy-actor-headshot-dark-1200.jpg'),
      contentUrl: absoluteUrl('/gallery/gary-lucy-actor-headshot-dark-1200.jpg'),
      width: 1170,
      height: 1322,
      caption: 'Gary Lucy, British screen and stage actor — official headshot',
      creditText: 'Gary Lucy official website; photograph by Jenny Scott Photography',
      copyrightNotice: '© Gary Lucy. All rights reserved.',
      license: absoluteUrl('/press/official-portraits/'),
      acquireLicensePage: absoluteUrl('/contact/'),
      creator: { '@type': 'Organization', name: 'Jenny Scott Photography' },
      datePublished: '2026-11-09',
      representativeOfPage: true,
    },
    {
      '@type': 'ImageObject',
      '@id': `${absoluteUrl('/gallery/headshot-checked-shirt/')}#image`,
      url: absoluteUrl('/gallery/gary-lucy-actor-headshot-checked-shirt-1200.jpg'),
      contentUrl: absoluteUrl('/gallery/gary-lucy-actor-headshot-checked-shirt-1200.jpg'),
      width: 1170,
      height: 1328,
      caption: 'Gary Lucy, British actor — official headshot in checked shirt',
      creditText: 'Gary Lucy official website; photograph by Jenny Scott Photography',
      copyrightNotice: '© Gary Lucy. All rights reserved.',
      license: absoluteUrl('/press/official-portraits/'),
      acquireLicensePage: absoluteUrl('/contact/'),
      creator: { '@type': 'Organization', name: 'Jenny Scott Photography' },
      datePublished: '2026-11-09',
    },
    {
      '@type': 'ImageObject',
      '@id': `${absoluteUrl('/gallery/portrait-white-shirt/')}#image`,
      url: absoluteUrl('/gallery/gary-lucy-actor-portrait-white-shirt-1200.jpg'),
      contentUrl: absoluteUrl('/gallery/gary-lucy-actor-portrait-white-shirt-1200.jpg'),
      width: 1170,
      height: 1222,
      caption: 'Gary Lucy, British actor — official studio portrait',
      creditText: 'Gary Lucy official website',
      copyrightNotice: '© Gary Lucy and/or the credited rightsholder. All rights reserved.',
      license: absoluteUrl('/press/official-portraits/'),
      acquireLicensePage: absoluteUrl('/contact/'),
    },
    {
      '@type': 'ImageObject',
      '@id': `${absoluteUrl('/gallery/instagram-headshot-dan-collins-2026/')}#image`,
      url: absoluteUrl('/gallery/gary-lucy-instagram-headshot-dan-collins-2026-480.jpg'),
      contentUrl: absoluteUrl('/gallery/gary-lucy-instagram-headshot-dan-collins-2026-480.jpg'),
      width: 480,
      height: 640,
      caption: 'Gary Lucy, British actor — official black and white headshot published by @gary.lucy in November 2026',
      creditText: 'Gary Lucy official website; photograph by Dan Collins; sourced from verified @gary.lucy Instagram',
      creator: { '@type': 'Person', name: 'Dan Collins' },
      datePublished: '2026-11-06',
      isBasedOn: 'https://www.instagram.com/p/DfaqpmnRGr5/',
      copyrightNotice: '© Gary Lucy; released under CC BY-SA 4.0.',
      license: 'https://creativecommons.org/licenses/by-sa/4.0/',
      acquireLicensePage: absoluteUrl('/contact/'),
    },
    {
      '@type': 'ImageObject',
      '@id': `${absoluteUrl('/gallery/brown-leather-jacket-headshot-2026/')}#image`,
      url: absoluteUrl('/gallery/gary-lucy-brown-leather-jacket-headshot-2026-360.jpg'),
      contentUrl: absoluteUrl('/gallery/gary-lucy-brown-leather-jacket-headshot-2026-360.jpg'),
      width: 360,
      height: 640,
      caption: 'Gary Lucy, British actor — official brown leather-jacket headshot, 2026 portrait selection',
      creditText: 'Gary Lucy official website; supplied via verified @gary.lucy Instagram',
      datePublished: '2026-11-09',
      isBasedOn: 'https://www.instagram.com/reel/C38ur8uIc1P/',
      copyrightNotice: '© Gary Lucy. All rights reserved.',
      license: absoluteUrl('/press/official-portraits/'),
      acquireLicensePage: absoluteUrl('/contact/'),
    },
    {
      '@type': 'ImageObject',
      '@id': `${absoluteUrl('/gallery/official-close-up-dark-coat-2026/')}#image`,
      url: absoluteUrl('/gallery/gary-lucy-british-actor-close-up-dark-coat-2026-512.jpg'),
      contentUrl: absoluteUrl('/gallery/gary-lucy-british-actor-close-up-dark-coat-2026-512.jpg'),
      width: 512,
      height: 1024,
      caption: 'Gary Lucy, British actor — official close-up portrait in a dark coat, 2026 selection',
      creditText: 'Gary Lucy official website',
      datePublished: '2026-11-09',
      copyrightNotice: '© Gary Lucy. All rights reserved.',
      license: absoluteUrl('/press/official-portraits/'),
      acquireLicensePage: absoluteUrl('/contact/'),
    },
  ],
  sameAs: profile.sameAs,
  worksFor: {
    '@type': 'Organization',
    '@id': 'https://sosglobalai.com/#organization',
    name: 'SOS Global AI',
    url: 'https://sosglobalai.com',
  },
  award: 'British Soap Award for Best Newcomer (2000)',
  knowsAbout: ['Acting', 'British television drama', 'British theatre'],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: 'Gary Lucy — Official Site',
  url: `${SITE_URL}/`,
  about: { '@id': `${SITE_URL}/#person` },
  publisher: { '@id': `${SITE_URL}/#person` },
};

// Auto-generate a simple Home > Page breadcrumb for any top-level page that
// doesn't already supply its own (e.g. screen/[slug].astro supplies a
// three-level Home > Screen > Role breadcrumb itself — never generate a
// second, conflicting one for those).
const hasOwnBreadcrumb = jsonLd.some((e: any) => e['@type'] === 'BreadcrumbList');
const pageLabels: Record<string, string> = {
  '/about': 'About',
  '/screen': 'Screen',
  '/stage': 'Stage',
  '/showreel': 'Showreel',
  '/filmography': 'Filmography',
  '/gallery': 'Gallery',
  '/instagram': 'Instagram',
  '/press': 'Press',
  '/contact': 'Contact',
  '/news': 'News',
  '/news/current-screen-work-2026': 'Current screen work',
};
const autoBreadcrumbLd =
  !hasOwnBreadcrumb && pageLabels[path]
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
          { '@type': 'ListItem', position: 2, name: pageLabels[path], item: canonical },
        ],
      }
    : null;

// A minimal WebPage entity per page, tying it into the WebSite + Person
// entity graph. AboutPage is used for /about specifically (a more precise
// subtype than the generic WebPage); every other page gets plain WebPage.
// Skipped when the page already supplies its own *Page entity (e.g. the
// homepage's ProfilePage in index.astro) to avoid two conflicting
// page-level entities describing the same URL.
const hasOwnPageEntity = jsonLd.some((e: any) => typeof e['@type'] === 'string' && e['@type'].endsWith('Page'));
const webPageLd = !hasOwnPageEntity
  ? {
      '@context': 'https://schema.org',
      '@type': path === '/about' ? 'AboutPage' : 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      about: { '@id': `${SITE_URL}/#person` },
      primaryImageOfPage: ogUrl,
    }
  : null;
---
<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
<link rel="canonical" href={canonical} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Gary Lucy — Official" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
{webPageLd && <script type="application/ld+json" set:html={JSON.stringify(webPageLd)} />}
{autoBreadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(autoBreadcrumbLd)} />}
{jsonLd.map((entry) => (
  <script type="application/ld+json" set:html={JSON.stringify(entry)} />
))}
